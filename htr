--=====================================================================
-- REGISTRY
--=====================================================================
local ALL = {}

local function mk(class, props)
    local ok, o = pcall(function() return Drawing.new(class) end)
    if not ok or not o then return nil end
    for k, v in pairs(props or {}) do o[k] = v end
    ALL[#ALL + 1] = o
    return o
end

local function hideAll()
    for i = 1, #ALL do
        local o = ALL[i]
        if o and o.Visible ~= nil then o.Visible = false end
    end
end

local function removeAll()
    for i = 1, #ALL do
        local o = ALL[i]
        if o and o.Remove then pcall(o.Remove) end
    end
    ALL = {}
end

local function text(pos, s, size, color, center)
    return mk("Text", {
        Text = tostring(s), Size = size or 13, Color = color or T.text,
        Center = center or false, Outline = true,
        OutlineColor = Color3.new(0, 0, 0), Font = FONT,
        Position = pos or Vector2.new(0, 0), Visible = false,
    })
end

local function sq(pos, size, color, filled, transparency, thickness)
    return mk("Square", {
        Position = pos or Vector2.new(0, 0), Size = size or Vector2.new(1, 1),
        Color = color or T.line, Filled = filled or false,
        Transparency = transparency or 0, Thickness = thickness or 1,
        Visible = false,
    })
end

local function circle(pos, radius, color, filled)
    return mk("Circle", {
        Position = pos or Vector2.new(0, 0), Radius = radius or 4,
        Color = color or T.text, Filled = filled or true,
        Thickness = 1, NumSides = 24, Visible = false,
    })
end

local function line2(a, b, color)
    return mk("Line", {
        From = a or Vector2.new(0, 0), To = b or Vector2.new(0, 0),
        Color = color or T.text, Thickness = 1, Visible = false,
    })
end

local function round(color, alpha)
    return {
        sq  = sq(nil, nil, color, true, alpha or 0),
        sq2 = sq(nil, nil, color, true, alpha or 0),
        c1  = circle(nil, 4, color, true),
        c2  = circle(nil, 4, color, true),
    }
end

local function showRound(r, x, y, w, h, radius)
    radius = math.min(radius or 6, h / 2, w / 2)
    r.sq.Visible = true
    r.sq.Position = Vector2.new(x + radius, y)
    r.sq.Size = Vector2.new(math.max(0, w - radius * 2), h)

    r.sq2.Visible = true
    r.sq2.Position = Vector2.new(x, y + radius)
    r.sq2.Size = Vector2.new(radius, math.max(0, h - radius * 2))

    r.c1.Visible = true
    r.c1.Position = Vector2.new(x + radius, y + radius)
    r.c1.Radius = radius

    r.c2.Visible = true
    r.c2.Position = Vector2.new(x + w - radius, y + radius)
    r.c2.Radius = radius
end

local function tint(r, c)
    r.sq.Color = c
    r.sq2.Color = c
    r.c1.Color = c
    r.c2.Color = c
end

--=====================================================================
-- ENTITY
--=====================================================================
local function w2s(pos)
    local sp, on = Cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on and sp.Z > 0
end

local function viewport()
    return Cam.ViewportSize
end

local function charOf(plr)
    local c = plr.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local head = c:FindFirstChild("Head")
    if not (hum and hrp and head) or hum.Health <= 0 then return end
    return c, hum, hrp, head
end

local function isEnemy(plr)
    if plr == LP then return false end
    if cfg.esp.teamCheck and LP.Team and plr.Team and plr.Team == LP.Team then
        return false
    end
    return true
end

local function pickPart(c, name)
    if name == "Nearest" then return c:FindFirstChild("HumanoidRootPart") end
    return c:FindFirstChild(name) or c:FindFirstChild("Head")
end

local function hasLOS(part)
    local origin = Cam.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, Cam }
    local res = WS:Raycast(origin, part.Position - origin, params)
    return res == nil or res.Instance:IsDescendantOf(part.Parent)
end

local AimPart = nil

local function findTarget(fovDeg, partName, wallCheck, teamCheck)
    local center = viewport() / 2
    local best, bestD = nil, fovDeg
    local myTeam = LP.Team

    for _, plr in ipairs(Players:GetPlayers()) do
        local skip = false
        if plr == LP then skip = true end
        if teamCheck and myTeam and plr.Team and plr.Team == myTeam then skip = true end

        if not skip then
            local c = charOf(plr)
            if c then
                local part = pickPart(c, partName)
                if part then
                    local sp, on = w2s(part.Position)
                    if on then
                        local d = (sp - center).Magnitude
                        if d < bestD and (not wallCheck or hasLOS(part)) then
                            bestD, best = d, part
                        end
                    end
                end
            end
        end
    end
    return best
end

--=====================================================================
-- CHAMS
--=====================================================================
local HL = {}

local function syncChams()
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = charOf(plr)
        local want = cfg.esp.enabled and cfg.esp.chams and c and isEnemy(plr)

        if not want then
            if HL[plr] then HL[plr]:Destroy() HL[plr] = nil end
        else
            local h = HL[plr]
            if not h or h.Parent ~= c then
                if h then h:Destroy() end
                h = Instance.new("Highlight")
                h.Name = "nl_chams"
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Adornee = c
                h.Parent = c
                HL[plr] = h
            end
            h.FillColor = cfg.esp.color
            h.OutlineColor = cfg.esp.color:Lerp(Color3.new(1, 1, 1), 0.35)
            h.FillTransparency = 0.55
            h.OutlineTransparency = 0
        end
    end
end

--=====================================================================
-- SILENT AIM
--=====================================================================
local silentHooked = false

local function installSilent()
    if silentHooked then return end
    if not (getrawmetatable and hookmetamethod and newcclosure and getnamecallmethod) then
        return
    end

    local mt = getrawmetatable(game)
    local old = mt.__namecall
    if not old then return end
    pcall(setreadonly, mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if cfg.silent.enabled and AimPart
           and (method == "Raycast" or method == "FindPartOnRay"
             or method == "FindPartOnRayWithIgnoreList"
             or method == "FindPartOnRayWithWhitelist") then

            local args = { ... }
            local target = AimPart.Position

            if method == "Raycast" then
                local o, d = args[1], args[2]
                if typeof(o) == "Vector3" and typeof(d) == "Vector3" then
                    local diff = target - o
                    if diff.Magnitude > 0 then
                        args[2] = diff.Unit * d.Magnitude
                        return old(self, args[1], args[2], args[3])
                    end
                end
            else
                local ray = args[1]
                if typeof(ray) == "Ray" then
                    local diff = target - ray.Origin
                    if diff.Magnitude > 0 then
                        args[1] = Ray.new(ray.Origin, diff.Unit * ray.Direction.Magnitude)
                    end
                end
            end

            return old(self, unpack(args))
        end

        return old(self, ...)
    end)

    pcall(setreadonly, mt, true)
    silentHooked = true
end

