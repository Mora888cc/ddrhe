local function page(p)
    UI.pages[p] = UI.pages[p] or { left = {}, right = {} }
    return UI.pages[p]
end

local function add(p, col, w)
    local pg = page(p)
    if col == "right" then
        pg.right[#pg.right + 1] = w
    else
        pg.left[#pg.left + 1] = w
    end
end

local function section(p, title, col)
    add(p, col, { kind = "section", title = title, tx = text(nil, title, 13, T.text) })
end

local function toggle(p, title, t, k, col)
    add(p, col, {
        kind = "toggle", title = title, t = t, k = k,
        tx = text(nil, title, 13, T.text),
        tr = round(T.off, 0),
        kn = circle(nil, 6, T.text, true),
    })
end

local function slider(p, title, t, k, mn, mx, suffix, col)
    add(p, col, {
        kind = "slider", title = title, t = t, k = k,
        min = mn, max = mx, suffix = suffix or "",
        tx = text(nil, title, 13, T.text),
        val = text(nil, "", 12, T.dim),
        tr = sq(nil, nil, T.off, true),
        fl = sq(nil, nil, T.on, true),
        kn = circle(nil, 5, T.text, true),
    })
end

local function dropdown(p, title, t, k, items, col)
    local w = {
        kind = "dropdown", title = title, t = t, k = k,
        items = items, open = false,
        tx = text(nil, title, 13, T.text),
        bx = round(T.off, 0),
        cur = text(nil, "", 12, T.text),
        arw = text(nil, "v", 10, T.dim),
        opts = {},
    }
    for i, name in ipairs(items) do
        w.opts[i] = { bg = sq(nil, nil, T.panel2, true), tx = text(nil, name, 12, T.text) }
    end
    add(p, col, w)
end

local function keybind(p, title, t, k, col)
    add(p, col, {
        kind = "keybind", title = title, t = t, k = k,
        tx = text(nil, title, 13, T.text),
        bx = round(T.off, 0),
        cur = text(nil, "", 12, T.text, true),
    })
end

local function setVal(t, k, v)
    t[k] = v
    if k == "colorName" then
        cfg.esp.color = COLORS[v] or cfg.esp.color
    end
end

